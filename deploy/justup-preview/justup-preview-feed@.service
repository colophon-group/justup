# One bounded connection per invocation; no permanent reader or crawler access.
[Unit]
Description=Justup private feed receiver
Requires=srv-justup_preview.mount
After=srv-justup_preview.mount
RequiresMountsFor=/srv/justup_preview
PartOf=justup-preview-feed.socket

[Service]
Type=exec
User=justup-preview-api
Group=justup-preview-api
Slice=justup-preview.slice
WorkingDirectory=/srv/justup_preview/ops
ExecStart=/usr/bin/python3 /srv/justup_preview/ops/preview-feed.py receive
StandardInput=socket
StandardOutput=socket
StandardError=null
TimeoutStartSec=330
RuntimeMaxSec=330
UMask=0077
NoNewPrivileges=yes
CapabilityBoundingSet=
AmbientCapabilities=
ProtectSystem=strict
ProtectHome=yes
PrivateDevices=yes
PrivateTmp=yes
TemporaryFileSystem=/tmp:ro /var/tmp:ro
ReadWritePaths=/srv/justup_preview/state/feed-inbox
ReadOnlyPaths=/srv/justup_preview/ops
InaccessiblePaths=-/srv/justup_preview/queue -/srv/justup_preview/model -/srv/justup_preview/broker -/srv/justup_preview/config -/run/docker.sock -/var/run/docker.sock -/mnt/murmur -/root -/home
RestrictAddressFamilies=AF_UNIX
IPAddressDeny=any
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
RestrictSUIDSGID=yes
RestrictRealtime=yes
LockPersonality=yes
LimitCORE=0
LimitNOFILE=64
LimitNPROC=8
