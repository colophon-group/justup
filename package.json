{
  "name": "justup",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "test:syntax": "npm run typecheck",
    "test:browser": "playwright test",
    "test": "npm run test:full",
    "test:deployment": "node scripts/test-deployment.mjs",
    "test:full": "npm run build && npm run test:web && npm run test:deployment && npm run test:server && npm run test:python && npm run test:browser",
    "test:server": "node scripts/test-server.mjs",
    "test:python": "python3 scripts/test-python.py",
    "dev": "vite --config vite.config.ts",
    "build": "npm run typecheck && vite build --config vite.config.ts",
    "preview": "vite preview --config vite.config.ts --host 127.0.0.1 --port 4173",
    "typecheck": "tsc --noEmit",
    "test:web": "node scripts/test-web.mjs"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "typescript": "7.0.2",
    "vite": "8.3.5",
    "@types/node": "24.12.0"
  },
  "dependencies": {
    "react": "19.3.1",
    "react-dom": "19.3.1"
  }
}
