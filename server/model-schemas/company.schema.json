{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "additionalProperties": false,
  "required": ["status", "candidate", "clarification"],
  "properties": {
    "status": { "type": "string", "enum": ["candidate", "clarification", "unresolved"] },
    "candidate": {
      "anyOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["name", "domain", "websiteUrl", "evidenceUrls"],
          "properties": {
            "name": { "type": "string", "minLength": 1, "maxLength": 200 },
            "domain": { "type": "string", "minLength": 3, "maxLength": 253 },
            "websiteUrl": { "type": "string", "minLength": 8, "maxLength": 2048 },
            "evidenceUrls": { "type": "array", "minItems": 1, "maxItems": 2, "items": { "type": "string", "minLength": 8, "maxLength": 2048 } }
          }
        }
      ]
    },
    "clarification": { "anyOf": [{ "type": "null" }, { "type": "string", "minLength": 1, "maxLength": 500 }] }
  }
}
